<idea-plugin>

  <id>io.github.afa_simoes.changelistsorter</id>
  <name>Changelist Sorter</name>

  <vendor
      email="57225419+AFA-Simoes@users.noreply.github.com"
      url="https://github.com/AFA-Simoes/changelist-sorter">
          AFA-Simoes
  </vendor>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.vcs</depends>

  <resource-bundle>io.github.afa_simoes.changelistsorter.changelistorganizer</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <projectConfigurable id="ChangelistOrganizer"
                         groupId="tools"
                         instance="io.github.afa_simoes.changelistsorter.settings.ProjectSettingsConfigurable"
                         key="settings.project.groupTitle"
                         bundle="io.github.afa_simoes.changelistsorter.changelistorganizer" />
    <projectService serviceImplementation="io.github.afa_simoes.changelistsorter.settings.ProjectSettingsService"/>
    <projectService serviceImplementation="io.github.afa_simoes.changelistsorter.organize.ChangelistOrganizerService"/>
  </extensions>

  <projectListeners>
    <listener class="io.github.afa_simoes.changelistsorter.listener.OrganizeOnChangeListener"
              topic="com.intellij.openapi.vcs.changes.ChangeListListener"/>
  </projectListeners>

  <actions>
    <action id="ChangesViewToolbarAction" class="io.github.afa_simoes.changelistsorter.action.OrganizeChangesAction">
      <add-to-group group-id="ChangesViewToolbar" anchor="last"/>
    </action>
    <action id="SelectedChangelistPopupAction" class="io.github.afa_simoes.changelistsorter.action.OrganizeChangesAction">
      <add-to-group group-id="ChangesViewPopupMenu" anchor="last"/>
    </action>
  </actions>

</idea-plugin>
